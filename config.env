# talos-proxmox-kit configuration
# Every script sources this file. Change values here, not in the scripts.

# --- Cluster ---
CLUSTER_NAME="sbek-k8s"
TALOS_VERSION="v1.14.4"
VIP="192.168.1.110"                 # floating Kubernetes API address
GATEWAY="192.168.1.1"
PREFIX="24"
NAMESERVERS="192.168.1.194 192.168.1.196"

# Image Factory schematic ID (nocloud, amd64, UEFI, with extensions:
# fuse3, intel-ice-firmware, intel-ucode, iscsi-tools, qemu-guest-agent)
SCHEMATIC_ID="cafdadef7d1a3353b559d08afc256bbcbbd50915385003c221e7a6b7e98bf7f1"

# --- Proxmox ---
STORAGE="local-lvm"
BRIDGE="vmbr0"
ISO_NAME="talos-${TALOS_VERSION}.iso"
CP_CORES=4;     CP_MEM=8192;     CP_DISK=50
WORKER_CORES=6; WORKER_DISK=100

# --- Nodes ---
# name | role | proxmox host | vmid | static IP | worker RAM (MB, ignored for cp)
NODES="
sbek-cp-1   cp     192.168.1.221 100 192.168.1.111 0
sbek-cp-2   cp     192.168.1.222 101 192.168.1.112 0
sbek-cp-3   cp     192.168.1.223 102 192.168.1.113 0
sbek-node-1 worker 192.168.1.221 200 192.168.1.114 20480
sbek-node-2 worker 192.168.1.222 201 192.168.1.116 20480
sbek-node-3 worker 192.168.1.223 202 192.168.1.117 16384
"

# --- Add-on versions (what this lab was built and tested with) ---
CILIUM_VERSION="1.20.4"
ENVOY_GATEWAY_VERSION="v1.9.1"

# --- MetalLB ---
METALLB_RANGE="192.168.1.234-192.168.1.241"

# --- Envoy Gateway ---
GATEWAY_IP="192.168.1.234"          # fixed MetalLB IP every app hostname points to
DOMAIN="shakeen.net"                # apps become <name>.${DOMAIN}

# --- Local paths ---
OUT_DIR="${HOME}/.talos/${CLUSTER_NAME}"
